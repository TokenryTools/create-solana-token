# All optional. Variables set in your shell take precedence over this file.

# Custom RPC endpoint for the cluster you use (devnet by default, mainnet with --mainnet).
# Never commit a real URL that contains an API key.
RPC_URL=https://api.devnet.solana.com

# Custom WebSocket endpoint. Default: RPC_URL with https:// replaced by wss://
# RPC_WS_URL=wss://api.devnet.solana.com

# Keypair file that pays and signs. Default: ~/.config/solana/id.json
# KEYPAIR_PATH=/home/you/.config/solana/id.json
